# Server Configuration
PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://mongodb:27017/allocation_ai

# JWT Configuration
JWT_SECRET=allocation_ai_super_secret_jwt_key_2024_secure_and_resilient_token_generator
JWT_EXPIRE=7d
JWT_COOKIE_EXPIRE=7

# Email Service (Default to Mailtrap / SMTP compatible)
EMAIL_HOST=smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_USER=demo_user
EMAIL_PASS=demo_pass
EMAIL_FROM=Allocation AI <no-reply@allocation-ai.example>

# AI Microservice Internal Endpoint
AI_SERVICE_URL=http://ai-service:5001

# Client & CORS
CLIENT_URL=http://localhost:3000
VITE_API_URL=http://localhost:5000/api/v1

# Local Upload Settings
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880
